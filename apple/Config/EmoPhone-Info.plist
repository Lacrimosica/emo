<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged with the generated Info.plist. Lets Ask Emo reach an Ollama server on the local
     network (e.g. http://192.168.1.20:11434 on your Mac); public hosts still need HTTPS. -->
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Emo connects to an Ollama server on your network when you choose Ollama in AI settings.</string>
</dict>
</plist>
